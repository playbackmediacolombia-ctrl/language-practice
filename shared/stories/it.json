    {
      "id": "it-doctor",
      "level": 3,
      "kind": "dialogue",
      "title": "Dal medico",
      "en": "At the doctor's",
      "speakers": {
        "dottoressa": {
          "name": "Dottoressa Ferri",
          "voice": "a"
        },
        "paziente": {
          "name": "Paolo",
          "voice": "b"
        }
      },
      "lines": [
        {
          "speaker": "dottoressa",
          "text": "Buongiorno, Paolo. Cosa si sente?",
          "en": "Good morning, Paolo. How are you feeling?"
        },
        {
          "speaker": "paziente",
          "text": "Ho mal di gola e un po' di febbre.",
          "en": "I have a sore throat and a bit of a fever."
        },
        {
          "speaker": "dottoressa",
          "text": "Da quando?",
          "en": "Since when?"
        },
        {
          "speaker": "paziente",
          "text": "Da l'altro ieri. Ieri non sono riuscito a lavorare.",
          "en": "Since the day before yesterday. Yesterday I couldn't work."
        },
        {
          "speaker": "dottoressa",
          "text": "Le prescrivo uno sciroppo. Lo prenda tre volte al giorno.",
          "en": "I'll prescribe you a syrup. Take it three times a day."
        },
        {
          "speaker": "paziente",
          "text": "Posso prenderlo a stomaco vuoto?",
          "en": "Can I take it on an empty stomach?"
        },
        {
          "speaker": "dottoressa",
          "text": "Meglio dopo i pasti. E beva molta acqua!",
          "en": "Better after meals. And drink lots of water!"
        }
      ],
