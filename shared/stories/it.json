    {
      "id": "it-directions",
      "level": 2,
      "kind": "dialogue",
      "title": "Dov'è la stazione?",
      "en": "Where is the station?",
      "speakers": {
        "turista": {
          "name": "Turista",
          "voice": "a"
        },
        "signore": {
          "name": "Signor Bruno",
          "voice": "b"
        }
      },
      "lines": [
        {
          "speaker": "turista",
          "text": "Scusi, dov'è la stazione della metro?",
          "en": "Excuse me, where is the metro station?"
        },
        {
          "speaker": "signore",
          "text": "È vicina. Vada dritto per due isolati.",
          "en": "It's close. Go straight for two blocks."
        },
        {
          "speaker": "turista",
          "text": "E poi?",
          "en": "And then?"
        },
        {
          "speaker": "signore",
          "text": "Poi giri a destra alla farmacia.",
          "en": "Then turn right at the pharmacy."
        },
        {
          "speaker": "turista",
          "text": "È lontano?",
          "en": "Is it far?"
        },
        {
          "speaker": "signore",
          "text": "No, sono cinque minuti a piedi.",
          "en": "No, it's five minutes on foot."
        },
        {
          "speaker": "turista",
          "text": "Grazie mille!",
          "en": "Thanks a lot!"
        },
        {
          "speaker": "signore",
          "text": "Prego. Buon viaggio!",
          "en": "You're welcome. Have a good trip!"
        }
      ],
