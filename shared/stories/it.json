    {
      "id": "it-saturday",
      "level": 2,
      "kind": "story",
      "title": "Il sabato di Luca",
      "en": "Luca's Saturday",
      "lines": [
        {
          "text": "Il sabato, Luca si sveglia tardi.",
          "en": "On Saturdays, Luca wakes up late."
        },
        {
          "text": "Fa colazione con sua sorella.",
          "en": "He has breakfast with his sister."
        },
        {
          "text": "Poi vanno al mercato.",
          "en": "Then they go to the market."
        },
        {
          "text": "Comprano frutta, formaggio e pane fresco.",
          "en": "They buy fruit, cheese and fresh bread."
        },
        {
          "text": "Il pomeriggio, Luca gioca a calcio con gli amici.",
          "en": "In the afternoon, Luca plays football with his friends."
        },
        {
          "text": "La sera è molto stanco e va a letto presto.",
          "en": "In the evening he's very tired and goes to bed early."
