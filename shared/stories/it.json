    {
      "id": "it-dt-first-date",
      "level": 4,
      "kind": "dialogue",
      "topic": "dating",
      "title": "Il primo appuntamento",
      "en": "A first date",
      "speakers": {
        "giulia": {
          "name": "Giulia",
          "voice": "a"
        },
        "matteo": {
          "name": "Matteo",
          "voice": "b"
        }
      },
      "lines": [
        {
          "speaker": "giulia",
          "text": "Scusa il ritardo! C'era un traffico pazzesco.",
          "en": "Sorry I'm late! The traffic was crazy."
        },
        {
          "speaker": "matteo",
          "text": "Figurati, sono appena arrivato. Ho scelto questo posto perché mi avevi detto che ti piacciono i locali tranquilli.",
          "en": "Don't worry, I just got here. I chose this place because you told me you like quiet places."
        },
        {
          "speaker": "giulia",
          "text": "Che carino che te lo sei ricordato! Allora, com'è andata la settimana?",
          "en": "How sweet that you remembered! So, how did your week go?"
        },
        {
          "speaker": "matteo",
          "text": "Intensa, ma bella. E tu, come va con l'università?",
          "en": "Busy, but good. And you, how's university going?"
        },
        {
          "speaker": "giulia",
          "text": "Faticosa, ma la adoro. Sto progettando una biblioteca.",
          "en": "Tiring, but I love it. I'm designing a library."
        },
        {
          "speaker": "matteo",
          "text": "Che bello. Me la fai vedere un giorno?",
          "en": "How lovely. Will you show it to me one day?"
        }
      ],
