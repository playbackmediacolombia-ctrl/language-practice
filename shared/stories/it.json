      "level": 1,
      "kind": "story",
      "title": "Il mio gatto",
      "en": "My cat",
      "lines": [
        {
          "text": "Ho un gatto.",
          "en": "I have a cat."
        },
        {
          "text": "Si chiama Tito.",
          "en": "His name is Tito."
        },
        {
          "text": "Tito è nero e piccolo.",
          "en": "Tito is black and small."
        },
        {
          "text": "Gli piace dormire sul divano.",
          "en": "He likes to sleep on the sofa."
        },
        {
          "text": "La mattina, Tito mangia il pesce.",
          "en": "In the morning, Tito eats fish."
        },
        {
          "text": "Tito è il mio amico!",
          "en": "Tito is my friend!"
        }
