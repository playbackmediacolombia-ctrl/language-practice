    {
      "id": "it-napoli",
      "level": 3,
      "kind": "story",
      "title": "Un viaggio a Napoli",
      "en": "A trip to Naples",
      "lines": [
        {
          "text": "L'anno scorso sono andata a Napoli con la mia migliore amica.",
          "en": "Last year I went to Naples with my best friend."
        },
        {
          "text": "Abbiamo dormito in un piccolo albergo vicino al mare.",
          "en": "We slept in a small hotel near the sea."
        },
        {
          "text": "Ogni mattina prendevamo un caffè al bar sotto casa.",
          "en": "Every morning we had a coffee at the café downstairs."
        },
        {
          "text": "Un giorno abbiamo visitato Pompei e abbiamo camminato per ore.",
          "en": "One day we visited Pompeii and walked for hours."
        },
        {
          "text": "La sera mangiavamo la pizza più buona del mondo.",
          "en": "In the evenings we ate the best pizza in the world."
        },
        {
          "text": "È stato il viaggio più bello della mia vita.",
          "en": "It was the most beautiful trip of my life."
        }
