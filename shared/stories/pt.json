      "id": "pt-cat",
      "level": 1,
      "kind": "story",
      "title": "Meu gato",
      "en": "My cat",
      "lines": [
        {
          "text": "Eu tenho um gato.",
          "en": "I have a cat."
        },
        {
          "text": "Ele se chama Tito.",
          "en": "His name is Tito."
        },
        {
          "text": "Tito é preto e pequeno.",
          "en": "Tito is black and small."
        },
        {
          "text": "Ele gosta de dormir no sofá.",
          "en": "He likes to sleep on the sofa."
        },
        {
          "text": "De manhã, Tito come peixe.",
          "en": "In the morning, Tito eats fish."
        },
        {
          "text": "Tito é meu amigo!",
          "en": "Tito is my friend!"
        }
