    {
      "id": "pt-directions",
      "level": 2,
      "kind": "dialogue",
      "title": "Onde fica a estação?",
      "en": "Where is the station?",
      "speakers": {
        "turista": {
          "name": "Turista",
          "voice": "a"
        },
        "senhor": {
          "name": "Seu Carlos",
          "voice": "b"
        }
      },
      "lines": [
        {
          "speaker": "turista",
          "text": "Com licença, onde fica a estação de metrô?",
          "en": "Excuse me, where is the subway station?"
        },
        {
          "speaker": "senhor",
          "text": "Fica perto. Siga reto por duas quadras.",
          "en": "It's close. Go straight for two blocks."
        },
        {
          "speaker": "turista",
          "text": "E depois?",
          "en": "And then?"
        },
        {
          "speaker": "senhor",
          "text": "Depois, vire à direita na farmácia.",
          "en": "Then turn right at the pharmacy."
        },
        {
          "speaker": "turista",
          "text": "É longe?",
          "en": "Is it far?"
        },
        {
          "speaker": "senhor",
          "text": "Não, são cinco minutos a pé.",
          "en": "No, it's five minutes on foot."
        },
        {
          "speaker": "turista",
          "text": "Muito obrigada!",
          "en": "Thank you very much!"
        },
        {
          "speaker": "senhor",
          "text": "De nada. Boa viagem!",
          "en": "You're welcome. Have a good trip!"
        }
      ],
