      "lines": [
        {
          "speaker": "medica",
          "text": "Bom dia, Rafael. O que você está sentindo?",
          "en": "Good morning, Rafael. How are you feeling?"
        },
        {
          "speaker": "paciente",
          "text": "Estou com dor de garganta e um pouco de febre.",
          "en": "I have a sore throat and a bit of a fever."
        },
        {
          "speaker": "medica",
          "text": "Desde quando?",
          "en": "Since when?"
        },
        {
          "speaker": "paciente",
          "text": "Desde anteontem. Ontem não consegui trabalhar.",
          "en": "Since the day before yesterday. Yesterday I couldn't work."
        },
        {
          "speaker": "medica",
          "text": "Vou te receitar um remédio. Tome três vezes por dia.",
          "en": "I'll prescribe you some medicine. Take it three times a day."
        },
        {
          "speaker": "paciente",
          "text": "Posso tomar com o estômago vazio?",
          "en": "Can I take it on an empty stomach?"
        },
        {
          "speaker": "medica",
          "text": "Melhor depois das refeições. E beba muita água!",
          "en": "Better after meals. And drink lots of water!"
        }
