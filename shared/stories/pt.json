          "text": "Sim, um pão de queijo.",
          "en": "Yes, a cheese bread."
        },
        {
          "speaker": "joao",
          "text": "Com açúcar?",
          "en": "With sugar?"
        },
        {
          "speaker": "ana",
          "text": "Não, sem açúcar. Quanto é?",
          "en": "No, without sugar. How much is it?"
        },
        {
          "speaker": "joao",
          "text": "São oito reais.",
          "en": "That's eight reais."
