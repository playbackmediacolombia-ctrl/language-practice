    {
      "id": "pt-saturday",
      "level": 2,
      "kind": "story",
      "title": "O sábado do Pedro",
      "en": "Pedro's Saturday",
      "lines": [
        {
          "text": "No sábado, Pedro acorda tarde.",
          "en": "On Saturday, Pedro wakes up late."
        },
        {
          "text": "Ele toma café com a irmã dele.",
          "en": "He has breakfast with his sister."
        },
        {
          "text": "Depois, eles vão à praia.",
          "en": "Afterwards, they go to the beach."
        },
        {
          "text": "A água está fria, mas o sol está quente.",
          "en": "The water is cold, but the sun is hot."
        },
        {
          "text": "À tarde, Pedro joga futebol com os amigos.",
          "en": "In the afternoon, Pedro plays soccer with his friends."
        },
        {
          "text": "À noite, ele está muito cansado e dorme cedo.",
          "en": "At night, he's very tired and goes to bed early."
