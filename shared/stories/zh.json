    {
      "id": "zh-doctor",
      "level": 3,
      "kind": "dialogue",
      "title": "看医生",
      "en": "Seeing the doctor",
      "speakers": { "chen": { "name": "陈医生 Dr Chen", "voice": "b" }, "wangli": { "name": "王丽 Wáng Lì", "voice": "a" } },
      "lines": [
        { "speaker": "chen", "text": "你哪儿不舒服？", "seg": "你 哪儿 不 舒服 ？", "pinyin": "Nǐ nǎr bù shūfu?", "en": "What seems to be the problem?" },
        { "speaker": "wangli", "text": "我头疼，还有点儿发烧。", "seg": "我 头疼 ， 还 有点儿 发烧 。", "pinyin": "Wǒ tóuténg, hái yǒudiǎnr fāshāo.", "en": "I have a headache, and a bit of a fever." },
