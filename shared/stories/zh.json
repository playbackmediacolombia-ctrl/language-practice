      "questions": [
        { "q": "What is the cat called?", "options": ["Mimi", "Lili", "Huahua"], "answer": 0 },
        { "q": "What does it like to drink?", "options": ["Milk", "Water", "Tea"], "answer": 0 },
        { "q": "Where does it sleep at night?", "options": ["On my bed", "On the sofa", "Outside"], "answer": 0 }
      ]
    },
    {
      "id": "zh-fruit",
      "level": 1,
      "kind": "dialogue",
      "title": "买水果",
      "en": "Buying fruit",
      "speakers": { "xiaoming": { "name": "小明 Xiǎo Míng", "voice": "b" }, "wang": { "name": "王阿姨 Auntie Wang", "voice": "a" } },
      "lines": [
        { "speaker": "xiaoming", "text": "阿姨，苹果多少钱？", "seg": "阿姨 ， 苹果 多少 钱 ？", "pinyin": "Āyí, píngguǒ duōshao qián?", "en": "Auntie, how much are the apples?" },
        { "speaker": "wang", "text": "五块钱一斤。", "seg": "五 块 钱 一 斤 。", "pinyin": "Wǔ kuài qián yì jīn.", "en": "Five yuan a jin (half a kilo)." },
        { "speaker": "xiaoming", "text": "我要两斤。", "seg": "我 要 两 斤 。", "pinyin": "Wǒ yào liǎng jīn.", "en": "I'd like two jin." },
        { "speaker": "wang", "text": "好的。还要别的吗？", "seg": "好的 。 还 要 别的 吗 ？", "pinyin": "Hǎo de. Hái yào biéde ma?", "en": "OK. Anything else?" },
        { "speaker": "xiaoming", "text": "香蕉也要一斤。", "seg": "香蕉 也 要 一 斤 。", "pinyin": "Xiāngjiāo yě yào yì jīn.", "en": "A jin of bananas too." },
        { "speaker": "wang", "text": "一共十三块。", "seg": "一共 十三 块 。", "pinyin": "Yígòng shísān kuài.", "en": "Thirteen yuan altogether." },
        { "speaker": "xiaoming", "text": "给你。谢谢！", "seg": "给 你 。 谢谢 ！", "pinyin": "Gěi nǐ. Xièxie!", "en": "Here you are. Thanks!" }
      ],
      "glossary": {
        "阿姨": { "py": "āyí", "en": "auntie (polite for an older woman)" }, "苹果": { "py": "píngguǒ", "en": "apple" },
        "多少": { "py": "duōshao", "en": "how much, how many" }, "钱": { "py": "qián", "en": "money" }, "五": { "py": "wǔ", "en": "five" },
        "块": { "py": "kuài", "en": "yuan (spoken)" }, "一": { "py": "yì", "en": "one, a" }, "斤": { "py": "jīn", "en": "jin (half a kilo)" },
        "我": { "py": "wǒ", "en": "I" }, "要": { "py": "yào", "en": "to want" }, "两": { "py": "liǎng", "en": "two (of something)" },
        "好的": { "py": "hǎo de", "en": "OK" }, "还": { "py": "hái", "en": "still, also" }, "别的": { "py": "biéde", "en": "something else" },
        "吗": { "py": "ma", "en": "(question particle)" }, "香蕉": { "py": "xiāngjiāo", "en": "banana" }, "也": { "py": "yě", "en": "also, too" },
        "一共": { "py": "yígòng", "en": "altogether" }, "十三": { "py": "shísān", "en": "thirteen" }, "给": { "py": "gěi", "en": "to give" },
        "你": { "py": "nǐ", "en": "you" }, "谢谢": { "py": "xièxie", "en": "thank you" }
      },
      "questions": [
        { "q": "How much are the apples?", "options": ["5 yuan a jin", "3 yuan a jin", "10 yuan a jin"], "answer": 0 },
        { "q": "How many jin of apples does Xiao Ming buy?", "options": ["Two", "One", "Five"], "answer": 0 },
        { "q": "How much is it altogether?", "options": ["13 yuan", "10 yuan", "15 yuan"], "answer": 0 }
