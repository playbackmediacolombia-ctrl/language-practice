    {
      "id": "zh-cat",
      "level": 1,
      "kind": "story",
      "title": "我的猫",
      "en": "My cat",
      "lines": [
        { "text": "我有一只猫。", "seg": "我 有 一 只 猫 。", "pinyin": "Wǒ yǒu yì zhī māo.", "en": "I have a cat." },
        { "text": "它叫咪咪。", "seg": "它 叫 咪咪 。", "pinyin": "Tā jiào Mīmi.", "en": "Its name is Mimi." },
        { "text": "咪咪很小，也很可爱。", "seg": "咪咪 很 小 ， 也 很 可爱 。", "pinyin": "Mīmi hěn xiǎo, yě hěn kě'ài.", "en": "Mimi is small, and very cute." },
        { "text": "它喜欢喝牛奶。", "seg": "它 喜欢 喝 牛奶 。", "pinyin": "Tā xǐhuan hē niúnǎi.", "en": "It likes to drink milk." },
        { "text": "晚上，它在我的床上睡觉。", "seg": "晚上 ， 它 在 我 的 床 上 睡觉 。", "pinyin": "Wǎnshang, tā zài wǒ de chuáng shang shuìjiào.", "en": "At night, it sleeps on my bed." },
        { "text": "我很爱咪咪！", "seg": "我 很 爱 咪咪 ！", "pinyin": "Wǒ hěn ài Mīmi!", "en": "I love Mimi very much!" }
      ],
      "glossary": {
        "我": { "py": "wǒ", "en": "I, me" }, "有": { "py": "yǒu", "en": "to have" }, "一": { "py": "yì", "en": "one, a" },
        "只": { "py": "zhī", "en": "(measure word for animals)" }, "猫": { "py": "māo", "en": "cat" }, "它": { "py": "tā", "en": "it" },
        "叫": { "py": "jiào", "en": "to be called" }, "咪咪": { "py": "Mīmi", "en": "Mimi (a pet's name)" }, "很": { "py": "hěn", "en": "very" },
        "小": { "py": "xiǎo", "en": "small" }, "也": { "py": "yě", "en": "also, too" }, "可爱": { "py": "kě'ài", "en": "cute" },
        "喜欢": { "py": "xǐhuan", "en": "to like" }, "喝": { "py": "hē", "en": "to drink" }, "牛奶": { "py": "niúnǎi", "en": "milk" },
        "晚上": { "py": "wǎnshang", "en": "evening, at night" }, "在": { "py": "zài", "en": "at, on" }, "的": { "py": "de", "en": "'s (possessive)" },
        "床": { "py": "chuáng", "en": "bed" }, "上": { "py": "shang", "en": "on (top of)" }, "睡觉": { "py": "shuìjiào", "en": "to sleep" },
        "爱": { "py": "ài", "en": "to love" }
