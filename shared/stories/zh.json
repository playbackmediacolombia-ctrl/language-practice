    {
      "id": "zh-day",
      "level": 2,
      "kind": "story",
      "title": "我的一天",
      "en": "My day",
      "lines": [
        { "text": "我每天早上七点起床。", "seg": "我 每天 早上 七 点 起床 。", "pinyin": "Wǒ měitiān zǎoshang qī diǎn qǐchuáng.", "en": "Every day I get up at seven in the morning." },
        { "text": "我先喝一杯茶，然后吃早饭。", "seg": "我 先 喝 一 杯 茶 ， 然后 吃 早饭 。", "pinyin": "Wǒ xiān hē yì bēi chá, ránhòu chī zǎofàn.", "en": "First I drink a cup of tea, then I have breakfast." },
        { "text": "八点我坐地铁去上班。", "seg": "八 点 我 坐 地铁 去 上班 。", "pinyin": "Bā diǎn wǒ zuò dìtiě qù shàngbān.", "en": "At eight I take the subway to work." },
        { "text": "中午我和同事一起吃饭。", "seg": "中午 我 和 同事 一起 吃饭 。", "pinyin": "Zhōngwǔ wǒ hé tóngshì yìqǐ chīfàn.", "en": "At noon I eat with my colleagues." },
        { "text": "晚上我回家做饭，看一会儿书。", "seg": "晚上 我 回家 做饭 ， 看 一会儿 书 。", "pinyin": "Wǎnshang wǒ huíjiā zuòfàn, kàn yíhuìr shū.", "en": "In the evening I go home, cook, and read for a while." },
        { "text": "十一点我睡觉。", "seg": "十一 点 我 睡觉 。", "pinyin": "Shíyī diǎn wǒ shuìjiào.", "en": "At eleven I go to bed." }
      ],
      "glossary": {
        "我": { "py": "wǒ", "en": "I" }, "每天": { "py": "měitiān", "en": "every day" }, "早上": { "py": "zǎoshang", "en": "morning" },
        "七": { "py": "qī", "en": "seven" }, "点": { "py": "diǎn", "en": "o'clock" }, "起床": { "py": "qǐchuáng", "en": "to get up" },
        "先": { "py": "xiān", "en": "first" }, "喝": { "py": "hē", "en": "to drink" }, "一": { "py": "yì", "en": "one, a" },
        "杯": { "py": "bēi", "en": "cup (of)" }, "茶": { "py": "chá", "en": "tea" }, "然后": { "py": "ránhòu", "en": "then, after that" },
        "吃": { "py": "chī", "en": "to eat" }, "早饭": { "py": "zǎofàn", "en": "breakfast" }, "八": { "py": "bā", "en": "eight" },
        "坐": { "py": "zuò", "en": "to sit; to take (transport)" }, "地铁": { "py": "dìtiě", "en": "subway, metro" }, "去": { "py": "qù", "en": "to go" },
        "上班": { "py": "shàngbān", "en": "to go to work" }, "中午": { "py": "zhōngwǔ", "en": "noon" }, "和": { "py": "hé", "en": "and, with" },
        "同事": { "py": "tóngshì", "en": "colleague" }, "一起": { "py": "yìqǐ", "en": "together" }, "吃饭": { "py": "chīfàn", "en": "to eat (a meal)" },
        "晚上": { "py": "wǎnshang", "en": "evening" }, "回家": { "py": "huíjiā", "en": "to go home" }, "做饭": { "py": "zuòfàn", "en": "to cook" },
        "看": { "py": "kàn", "en": "to read, to look at" }, "一会儿": { "py": "yíhuìr", "en": "a little while" }, "书": { "py": "shū", "en": "book" },
        "十一": { "py": "shíyī", "en": "eleven" }, "睡觉": { "py": "shuìjiào", "en": "to sleep, go to bed" }
      },
      "questions": [
        { "q": "When does the speaker get up?", "options": ["At 7", "At 8", "At 11"], "answer": 0 },
        { "q": "How do they get to work?", "options": ["By subway", "By bus", "By bike"], "answer": 0 },
        { "q": "Who do they have lunch with?", "options": ["Their colleagues", "Their family", "Nobody"], "answer": 0 }
      ]
    },
    {
      "id": "zh-directions",
      "level": 2,
      "kind": "dialogue",
      "title": "问路",
      "en": "Asking the way",
      "speakers": { "lihua": { "name": "李华 Lǐ Huá", "voice": "a" }, "zhang": { "name": "张先生 Mr Zhang", "voice": "b" } },
      "lines": [
        { "speaker": "lihua", "text": "请问，地铁站在哪儿？", "seg": "请问 ， 地铁站 在 哪儿 ？", "pinyin": "Qǐngwèn, dìtiězhàn zài nǎr?", "en": "Excuse me, where is the subway station?" },
        { "speaker": "zhang", "text": "一直往前走，到路口往右拐。", "seg": "一直 往 前 走 ， 到 路口 往 右 拐 。", "pinyin": "Yìzhí wǎng qián zǒu, dào lùkǒu wǎng yòu guǎi.", "en": "Go straight ahead, and at the crossroads turn right." },
        { "speaker": "lihua", "text": "远不远？", "seg": "远 不 远 ？", "pinyin": "Yuǎn bu yuǎn?", "en": "Is it far?" },
        { "speaker": "zhang", "text": "不远，走路五分钟。", "seg": "不 远 ， 走路 五 分钟 。", "pinyin": "Bù yuǎn, zǒulù wǔ fēnzhōng.", "en": "Not far, five minutes on foot." },
        { "speaker": "lihua", "text": "太好了，谢谢您！", "seg": "太 好 了 ， 谢谢 您 ！", "pinyin": "Tài hǎo le, xièxie nín!", "en": "Great, thank you!" },
        { "speaker": "zhang", "text": "不客气。", "seg": "不客气 。", "pinyin": "Bú kèqi.", "en": "You're welcome." }
      ],
      "glossary": {
        "请问": { "py": "qǐngwèn", "en": "excuse me (may I ask)" }, "地铁站": { "py": "dìtiězhàn", "en": "subway station" },
        "在": { "py": "zài", "en": "to be at" }, "哪儿": { "py": "nǎr", "en": "where" }, "一直": { "py": "yìzhí", "en": "straight, all the way" },
        "往": { "py": "wǎng", "en": "towards" }, "前": { "py": "qián", "en": "front, ahead" }, "走": { "py": "zǒu", "en": "to walk, go" },
        "到": { "py": "dào", "en": "to arrive at; at" }, "路口": { "py": "lùkǒu", "en": "crossroads, intersection" }, "右": { "py": "yòu", "en": "right" },
        "拐": { "py": "guǎi", "en": "to turn" }, "远": { "py": "yuǎn", "en": "far" }, "不": { "py": "bù", "en": "not" },
        "走路": { "py": "zǒulù", "en": "to walk, on foot" }, "五": { "py": "wǔ", "en": "five" }, "分钟": { "py": "fēnzhōng", "en": "minute(s)" },
        "太": { "py": "tài", "en": "too, so" }, "好": { "py": "hǎo", "en": "good" }, "了": { "py": "le", "en": "(太好了: great!)" },
        "谢谢": { "py": "xièxie", "en": "thank you" }, "您": { "py": "nín", "en": "you (polite)" }, "不客气": { "py": "bú kèqi", "en": "you're welcome" }
      },
      "questions": [
        { "q": "Where does Li Hua want to go?", "options": ["The subway station", "The bank", "The hospital"], "answer": 0 },
        { "q": "Which way at the crossroads?", "options": ["Right", "Left", "Straight on"], "answer": 0 },
        { "q": "How far is it?", "options": ["Five minutes on foot", "Half an hour on foot", "Far: take a taxi"], "answer": 0 }
      ]
    },
    {
      "id": "zh-beijing",
      "level": 3,
      "kind": "story",
      "title": "去北京旅行",
      "en": "A trip to Beijing",
      "lines": [
        { "text": "去年夏天，我和朋友去北京旅行了。", "seg": "去年 夏天 ， 我 和 朋友 去 北京 旅行 了 。", "pinyin": "Qùnián xiàtiān, wǒ hé péngyou qù Běijīng lǚxíng le.", "en": "Last summer, a friend and I went on a trip to Beijing." },
        { "text": "我们坐高铁去的，只用了五个小时。", "seg": "我们 坐 高铁 去 的 ， 只 用 了 五 个 小时 。", "pinyin": "Wǒmen zuò gāotiě qù de, zhǐ yòng le wǔ ge xiǎoshí.", "en": "We went by high-speed train; it only took five hours." },
        { "text": "第一天我们参观了故宫，人非常多。", "seg": "第一 天 我们 参观 了 故宫 ， 人 非常 多 。", "pinyin": "Dì-yī tiān wǒmen cānguān le Gùgōng, rén fēicháng duō.", "en": "On the first day we visited the Forbidden City; it was very crowded." },
        { "text": "第二天我们去爬长城，虽然很累，但是风景特别美。", "seg": "第二 天 我们 去 爬 长城 ， 虽然 很 累 ， 但是 风景 特别 美 。", "pinyin": "Dì-èr tiān wǒmen qù pá Chángchéng, suīrán hěn lèi, dànshì fēngjǐng tèbié měi.", "en": "On the second day we climbed the Great Wall; it was tiring, but the view was especially beautiful." },
        { "text": "晚上我们吃了北京烤鸭。", "seg": "晚上 我们 吃 了 北京 烤鸭 。", "pinyin": "Wǎnshang wǒmen chī le Běijīng kǎoyā.", "en": "In the evening we ate Peking duck." },
        { "text": "我希望明年还能再去。", "seg": "我 希望 明年 还 能 再 去 。", "pinyin": "Wǒ xīwàng míngnián hái néng zài qù.", "en": "I hope I can go again next year." }
      ],
      "glossary": {
        "去年": { "py": "qùnián", "en": "last year" }, "夏天": { "py": "xiàtiān", "en": "summer" }, "我": { "py": "wǒ", "en": "I" },
        "和": { "py": "hé", "en": "and, with" }, "朋友": { "py": "péngyou", "en": "friend" }, "去": { "py": "qù", "en": "to go" },
        "北京": { "py": "Běijīng", "en": "Beijing" }, "旅行": { "py": "lǚxíng", "en": "to travel; a trip" }, "了": { "py": "le", "en": "(marks a completed action)" },
        "我们": { "py": "wǒmen", "en": "we" }, "坐": { "py": "zuò", "en": "to take (transport)" }, "高铁": { "py": "gāotiě", "en": "high-speed train" },
        "的": { "py": "de", "en": "(…去的: it was by … that we went)" }, "只": { "py": "zhǐ", "en": "only" }, "用": { "py": "yòng", "en": "to use; to take (time)" },
        "五": { "py": "wǔ", "en": "five" }, "个": { "py": "ge", "en": "(measure word)" }, "小时": { "py": "xiǎoshí", "en": "hour" },
        "第一": { "py": "dì-yī", "en": "first" }, "天": { "py": "tiān", "en": "day" }, "参观": { "py": "cānguān", "en": "to visit (a place)" },
        "故宫": { "py": "Gùgōng", "en": "the Forbidden City" }, "人": { "py": "rén", "en": "people" }, "非常": { "py": "fēicháng", "en": "extremely, very" },
        "多": { "py": "duō", "en": "many" }, "第二": { "py": "dì-èr", "en": "second" }, "爬": { "py": "pá", "en": "to climb" },
        "长城": { "py": "Chángchéng", "en": "the Great Wall" }, "虽然": { "py": "suīrán", "en": "although" }, "很": { "py": "hěn", "en": "very" },
        "累": { "py": "lèi", "en": "tired, tiring" }, "但是": { "py": "dànshì", "en": "but" }, "风景": { "py": "fēngjǐng", "en": "scenery, view" },
        "特别": { "py": "tèbié", "en": "especially" }, "美": { "py": "měi", "en": "beautiful" }, "晚上": { "py": "wǎnshang", "en": "evening" },
        "吃": { "py": "chī", "en": "to eat" }, "烤鸭": { "py": "kǎoyā", "en": "roast duck" }, "希望": { "py": "xīwàng", "en": "to hope" },
