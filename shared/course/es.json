    {
      "id": "u13",
      "title": "Health and feelings",
      "lessons": [
        {
          "id": "es-13-1",
          "title": "At the doctor",
          "items": [
            { "id": "me-duele-la-cabeza", "text": "Me duele la cabeza.", "en": "I have a headache." },
            { "id": "me-duele-aqui", "text": "Me duele aquí.", "en": "It hurts here." },
            { "id": "tengo-fiebre-desde-ayer", "text": "Tengo fiebre desde ayer.", "en": "I've had a fever since yesterday." },
            { "id": "soy-alergico-a-la-penicilina", "text": "Soy alérgico a la penicilina.", "en": "I'm allergic to penicillin. (man)" },
            { "id": "tome-esto-dos-veces-al-dia", "text": "Tome esto dos veces al día.", "en": "Take this twice a day." },
            { "id": "necesito-una-cita", "text": "Necesito pedir una cita con el médico.", "en": "I need to make a doctor's appointment." }
          ]
        },
        {
          "id": "es-13-2",
          "title": "How I feel",
          "items": [
            { "id": "estoy-preocupada", "text": "Estoy preocupada por mi hermano.", "en": "I'm worried about my brother. (woman)" },
            { "id": "estoy-muy-estresado", "text": "Estoy muy estresado últimamente.", "en": "I've been very stressed lately. (man)" },
            { "id": "estoy-orgulloso-de-ti", "text": "Estoy orgulloso de ti.", "en": "I'm proud of you. (man)" },
            { "id": "me-siento-mucho-mejor", "text": "Me siento mucho mejor.", "en": "I feel much better." },
            { "id": "me-da-verguenza", "text": "Me da vergüenza.", "en": "I'm embarrassed." },
            { "id": "no-te-preocupes", "text": "No te preocupes.", "en": "Don't worry." }
          ]
        },
        {
          "id": "es-13-3",
          "title": "Giving advice",
          "items": [
            { "id": "deberias-descansar", "text": "Deberías descansar.", "en": "You should rest." },
            { "id": "yo-que-tu-iria-al-medico", "text": "Yo que tú, iría al médico.", "en": "If I were you, I'd go to the doctor." },
            { "id": "si-yo-fuera-tu", "text": "Si yo fuera tú, no le diría nada.", "en": "If I were you, I wouldn't tell him anything." },
            { "id": "te-recomiendo-que-duermas-mas", "text": "Te recomiendo que duermas más.", "en": "I recommend that you sleep more." },
            { "id": "es-importante-que-tomes-agua", "text": "Es importante que tomes mucha agua.", "en": "It's important that you drink lots of water." },
