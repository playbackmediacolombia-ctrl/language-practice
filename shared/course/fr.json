      "lessons": [
        {
          "id": "fr-16-1",
          "title": "Agreeing and disagreeing",
          "items": [
            { "id": "je-suis-tout-a-fait-daccord", "text": "Je suis tout à fait d'accord.", "en": "I completely agree." },
            { "id": "je-ne-suis-pas-du-tout-daccord", "text": "Je ne suis pas du tout d'accord.", "en": "I don't agree at all." },
            { "id": "je-comprends-ton-point-de-vue-mais", "text": "Je comprends ton point de vue, mais je ne le partage pas.", "en": "I understand your point of view, but I don't share it." },
            { "id": "la-dessus-tu-as-raison", "text": "Là-dessus, tu as raison.", "en": "You're right about that." },
            { "id": "dans-une-certaine-mesure", "text": "Dans une certaine mesure, oui.", "en": "To a certain extent, yes." },
            { "id": "pas-question", "text": "Pas question !", "en": "No way!" }
          ]
        },
        {
          "id": "fr-16-2",
          "title": "Making your case",
          "items": [
            { "id": "dun-cote", "text": "D'un côté, c'est moins cher.", "en": "On the one hand, it's cheaper." },
            { "id": "de-lautre", "text": "De l'autre, ça pollue plus.", "en": "On the other hand, it pollutes more." },
            { "id": "ce-nest-pas-tout-a-fait-vrai", "text": "Ce n'est pas tout à fait vrai.", "en": "That's not entirely true." },
            { "id": "il-faut-tenir-compte-du-cout", "text": "Il faut tenir compte du coût.", "en": "You have to take the cost into account." },
            { "id": "meme-si-cest-difficile", "text": "Même si c'est difficile, ça vaut le coup.", "en": "Even if it's hard, it's worth it." },
            { "id": "cependant", "text": "cependant", "en": "however" }
          ]
        },
        {
          "id": "fr-16-3",
          "title": "Persuading and concluding",
          "items": [
            { "id": "les-chiffres-montrent", "text": "Les chiffres montrent le contraire.", "en": "The figures show the opposite." },
            { "id": "imagine-que-ca-tarrive", "text": "Imagine que ça t'arrive à toi.", "en": "Imagine it happening to you." },
            { "id": "ce-nest-pas-une-question-dargent", "text": "Ce n'est pas une question d'argent, mais de principe.", "en": "It's not about money, it's about principle." },
            { "id": "bref", "text": "Bref, il faut que ça change.", "en": "In short, things have to change." },
            { "id": "pour-conclure", "text": "Pour conclure, je tiens à remercier tout le monde.", "en": "To conclude, I'd like to thank everyone." },
            { "id": "on-nest-pas-daccord", "text": "On n'est pas d'accord, et ce n'est pas grave.", "en": "We don't agree, and that's okay." }
          ]
        }
      ]
    },
