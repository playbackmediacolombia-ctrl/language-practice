// Cloudflare Worker for the AI conversation partner (free Workers plan, no payment method).
// The Gemini key is a secret: `npx wrangler secret put GEMINI_API_KEY` (never in this file).
{
  "name": "learnguage-talk",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Workers AI, for the spoken replies (MeloTTS, within the free daily allowance).
  "ai": { "binding": "AI" },
  // Today's request count, for the daily cap.
  "kv_namespaces": [{ "binding": "USAGE", "id": "1570b2bc71e8496e80ee3081aa6fd8cf" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://learnguage.net,https://www.learnguage.net,https://playbackmediacolombia-ctrl.github.io",
    // Replies per day across everyone, well under the free Gemini quota.
    "DAILY_LIMIT": "300",
    // Camera mode photos per day, across everyone.
    "VISION_LIMIT": "100",
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
